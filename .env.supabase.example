# Optional FastAPI PostgreSQL configuration. Keep .env unchanged until ready.
# Copy the exact session pooler host from your Supabase project's Connect panel.
# URL-encode the password. Use a dedicated FrontDesk project/database.
# Download the project's root certificate and replace the absolute path below.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/ABSOLUTE/PATH/prod-supabase.cer

# Browser business reads/writes still use /api/v1; no Supabase browser key needed.
