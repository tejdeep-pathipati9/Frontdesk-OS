# Copy to .env in the repository root. Never commit your .env.
# Local prototype features; passwordless demo login stays disabled.
DEMO_MODE=true
ALLOW_DEMO_LOGIN=false
RESTAURANT_NAME=Momentuum Bistro
# Native development uses SQLite; Docker overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./frontdesk.db
SESSION_SECRET=local-demo-only-change-before-live-use
OWNER_EMAIL=owner@momentuumbistro.local
OWNER_NAME=
# scripts/setup_local.py generates a local password when this is empty.
OWNER_PASSWORD=
WEB_ORIGIN=http://127.0.0.1:3000

# Vapi: use SAVED assistants and a Custom Credential (Bearer) on the server URL.
VAPI_WEBHOOK_SECRET=
VAPI_PUBLIC_KEY=
# Optional server-side setup helper; never exposed to browser JavaScript.
VAPI_PRIVATE_KEY=
VAPI_CREDENTIAL_ID=
VAPI_SERVER_URL=
VAPI_RESTAURANT_ASSISTANT_ID=
VAPI_SALON_ASSISTANT_ID=

# Additional local experiment, not needed for the Vapi path or dashboard.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_API_TOKEN=
FRONTDESK_API_URL=http://127.0.0.1:8000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
# Optional interpreter for unfamiliar caller confirmation wording (also works with Vapi).
OLLAMA_CONFIRMATION_ENABLED=false
OLLAMA_CONFIRMATION_MODEL=qwen3.5:9b
OLLAMA_CONFIRMATION_TIMEOUT=3
LOCAL_STT_BASE_URL=http://127.0.0.1:8001/v1
LOCAL_STT_MODEL=whisper-1
LOCAL_TTS_BASE_URL=http://127.0.0.1:8880/v1
LOCAL_TTS_MODEL=kokoro
LOCAL_TTS_VOICE=af_heart
LOCAL_SPEECH_API_KEY=local

# Connector credentials are scoped to demo-tenant's seeded locations only.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_API_VERSION=2026-01-22
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
TOAST_RESTAURANT_GUID=
TOAST_API_URL=https://ws-api.toasttab.com
# This low-level adapter gate does not activate dashboard or agent order writes.
TOAST_ORDER_WRITE_ENABLED=false
